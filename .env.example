# Server only. Do not use NEXT_PUBLIC_ for any of these values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# UUID of the single Supabase Auth user allowed to administer PP.
ADMIN_USER_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional fallback until owner is saved in /admin. LINE U + 32 hex characters.
OWNER_LINE_USER_ID=
# Real LINE mentions by default. Enable for typed @น้องโจอา and legacy @pp commands.
ALLOW_TEXT_TRIGGER=false
# Random 32+ characters, for scheduled maintenance authentication.
CRON_SECRET=

# Optional semantic matching via Google Cloud (not Vercel AI Gateway).
# Keep disabled until Google billing/credentials have been verified.
AI_ENABLED=false
AI_MONTHLY_LIMIT=1000
OWNER_ALIASES=ปีโป้,ปป
# Express-mode API key restricted to Agent Platform; store as Production Secret.
GOOGLE_VERTEX_API_KEY=
# Alternatively use a dedicated service account with only required Vertex permissions.
GOOGLE_VERTEX_PROJECT=
# Service account JSON. Server secret only; do not commit or paste in chat.
GOOGLE_VERTEX_CREDENTIALS=
# Preferred where API keys are disallowed: Vercel OIDC + Google Workload Identity.
# These identifiers are not secrets; the runtime supplies short-lived identity tokens.
GOOGLE_AUTH_MODE=
GOOGLE_WIF_AUDIENCE=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
