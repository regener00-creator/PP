# Server only. Do not use NEXT_PUBLIC_ for any of these values.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME
# UUID of the single Supabase Auth user allowed to administer PP.
ADMIN_USER_ID=
LINE_CHANNEL_SECRET=
LINE_CHANNEL_ACCESS_TOKEN=
# Optional fallback until owner is saved in /admin. LINE U + 32 hex characters.
OWNER_LINE_USER_ID=
# Real LINE mentions by default. Enable only if you also want typed @pp commands.
ALLOW_TEXT_TRIGGER=false
# Random 32+ characters, for scheduled maintenance authentication.
CRON_SECRET=
